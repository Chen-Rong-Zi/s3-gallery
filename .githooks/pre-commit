#!/bin/sh
#
# s3-gallery pre-commit hook
# Runs checks from CLAUDE.md CI gate rules before each commit.
#
# To bypass: git commit --no-verify
# To install shared version: git config core.hooksPath .githooks
#

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# ── Configuration ──────────────────────────────────────────────
# Set to "true" to skip slow checks (clippy, tests) on tiny commits
SKIP_SLOW_ON_TYPOS="${SKIP_SLOW_ON_TYPOS:-false}"
# ──────────────────────────────────────────────────────────────

pass() {
    echo "${GREEN}✓${NC} $1"
}

fail() {
    echo "${RED}✗${NC} $1"
    exit_code=1
}

warn() {
    echo "${YELLOW}⚠${NC} $1"
}

exit_code=0

# Check if any Rust files were changed
changed_rs=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.rs$' || true)
changed_toml=$(git diff --cached --name-only --diff-filter=ACMR | grep 'Cargo\.toml$\|Cargo\.lock$' || true)
changed_any=$(git diff --cached --name-only --diff-filter=ACMR | grep -v '^\.gitignore$\|^README\|\.md$' || true)

# Only run Rust checks if Rust files or Cargo config changed
if [ -z "$changed_rs" ] && [ -z "$changed_toml" ]; then
    echo "No Rust files changed — skipping Rust checks."
    for f in $changed_any; do
        pass "staged: $f"
    done
    exit 0
fi

echo ""

# ── Step 1: Format check ──────────────────────────────────────
echo "=== cargo fmt --check ==="
if cargo fmt --all --check 2>/dev/null; then
    pass "Format check passed"
else
    # Show what needs formatting
    cargo fmt --all --check 2>&1 || true
    fail "Format check failed — run 'cargo fmt' to fix"
fi
echo ""

# ── Step 2: Clippy lint ───────────────────────────────────────
echo "=== cargo clippy (deny warnings) ==="
if cargo clippy --workspace -- -D warnings 2>&1; then
    pass "Clippy passed"
else
    fail "Clippy found issues — fix them before committing"
fi
echo ""

# ── Step 3: Unit tests + doc tests ────────────────────────────
echo "=== cargo test (lib + doc) ==="
if cargo test --lib 2>&1; then
    pass "Unit tests passed"
else
    fail "Unit tests failed"
fi
echo ""

if cargo test --doc 2>&1; then
    pass "Doc tests passed"
else
    fail "Doc tests failed"
fi
echo ""

# ── Summary ────────────────────────────────────────────────────
echo "=============================="
if [ "$exit_code" -eq 0 ]; then
    echo "${GREEN}All checks passed — committing${NC}"
else
    echo "${RED}Some checks failed — fix and try again${NC}"
    echo "To bypass: git commit --no-verify"
fi
echo "=============================="

exit "$exit_code"